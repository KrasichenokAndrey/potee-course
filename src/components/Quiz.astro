---
import { createHash } from "node:crypto";

interface QuizQuestion {
  type: "single";
  text: string;
  options: string[];
  answer: number;
  explanation?: string;
  source?: string;
}

interface QuizData {
  title: string;
  draft?: boolean;
  questions: QuizQuestion[];
}

interface Props {
  slug: string;
  quiz: QuizData;
}

const { slug, quiz } = Astro.props;
const quizJson = JSON.stringify(quiz).replaceAll("<", "\\u003c");
const version = createHash("sha256").update(quizJson).digest("hex");
const first = quiz.questions[0];
---

<section class="quiz" data-quiz data-slug={slug} data-version={version}>
  {quiz.draft && <p class="notice">Это шаблон теста. Замените вопросы перед публикацией учебного раздела.</p>}
  <script type="application/json" data-quiz-data set:html={quizJson}></script>
  <noscript><p class="notice">Для прохождения теста включите JavaScript в браузере.</p></noscript>
  <div class="quiz-session" data-quiz-session>
    <p class="quiz-instruction">Выберите вариант — ответ проверится сразу. Затем переходите к следующему вопросу.</p>
    <div class="quiz-progress">
      <span data-quiz-position tabindex="-1">Вопрос 1 из {quiz.questions.length}</span>
      <span data-quiz-score>Верных ответов: 0</span>
    </div>
    <progress class="quiz-progress-bar" data-quiz-progress value="0" max={quiz.questions.length} aria-label="Отвечено на вопросы"></progress>
    <fieldset class="quiz-question" data-quiz-card>
      <legend data-question-text>{first.text}</legend>
      <div class="quiz-options" data-quiz-options>
        {first.options.map((option, index) => (
          <button type="button" class="quiz-option" data-answer value={index + 1}>
            <span class="quiz-option-number" aria-hidden="true">{index + 1}</span>
            <span>{option}</span>
          </button>
        ))}
      </div>
      <div class="quiz-feedback" data-question-feedback role="status" tabindex="-1" hidden></div>
    </fieldset>
    <div class="quiz-actions">
      <button class="button" type="button" data-quiz-next disabled>Следующий вопрос</button>
    </div>
  </div>
  <div class="quiz-result" data-quiz-result role="region" aria-label="Результат теста" tabindex="-1" hidden></div>
  <div class="quiz-actions">
    <button class="button button--secondary" type="button" data-quiz-reset>Начать заново</button>
  </div>
</section>

<script>
  import { quizResultsKey } from "../lib/quiz-storage";

  const sessionsKey = "potee:quiz-sessions:v1";

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, (character) => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    })[character]);
  }

  function readStore(key) {
    try {
      const value = JSON.parse(localStorage.getItem(key) || "{}");
      return value && typeof value === "object" && !Array.isArray(value) ? value : {};
    } catch {
      return {};
    }
  }

  function writeStore(key, slug, value) {
    try {
      const store = readStore(key);
      if (value === null) delete store[slug];
      else store[slug] = value;
      localStorage.setItem(key, JSON.stringify(store));
    } catch {
      // The cards still work when browser storage is unavailable.
    }
  }

  function setupQuiz(root) {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const { slug, version } = root.dataset;
    const quiz = JSON.parse(root.querySelector("[data-quiz-data]").textContent);
    const questions = quiz.questions;
    const session = root.querySelector("[data-quiz-session]");
    const card = root.querySelector("[data-quiz-card]");
    const questionText = root.querySelector("[data-question-text]");
    const options = root.querySelector("[data-quiz-options]");
    const position = root.querySelector("[data-quiz-position]");
    const scoreLabel = root.querySelector("[data-quiz-score]");
    const progress = root.querySelector("[data-quiz-progress]");
    const feedback = root.querySelector("[data-question-feedback]");
    const next = root.querySelector("[data-quiz-next]");
    const reset = root.querySelector("[data-quiz-reset]");
    const resultBox = root.querySelector("[data-quiz-result]");
    let index = 0;
    let answers = questions.map(() => null);

    function validAnswer(answer, questionIndex) {
      return Number.isInteger(answer) && answer >= 1 && answer <= questions[questionIndex].options.length;
    }

    function saveSession() {
      writeStore(sessionsKey, slug, { version, index, answers });
    }

    function updateProgress() {
      progress.value = answers.filter((answer) => answer !== null).length;
      scoreLabel.textContent = `Верных ответов: ${answers.filter((answer, i) => answer === questions[i].answer).length}`;
    }

    function showFeedback() {
      const question = questions[index];
      const selected = answers[index];
      const correct = selected === question.answer;
      card.dataset.state = correct ? "correct" : "wrong";
      options.querySelectorAll("[data-answer]").forEach((button) => {
        button.disabled = true;
        const value = Number(button.value);
        if (value === question.answer) button.dataset.state = "correct";
        else if (value === selected) button.dataset.state = "wrong";
      });
      feedback.innerHTML = `
        <p><strong>${correct ? "Верно!" : "Неверно."}</strong></p>
        ${correct ? "" : `<p>Ваш ответ: ${escapeHtml(question.options[selected - 1])}</p>
          <p><strong>Правильный ответ:</strong> ${escapeHtml(question.options[question.answer - 1])}</p>`}
        ${question.explanation ? `<p>${escapeHtml(question.explanation)}</p>` : ""}
        ${question.source ? `<p class="source">${escapeHtml(question.source)}</p>` : ""}
      `;
      feedback.hidden = false;
      next.disabled = false;
      updateProgress();
    }

    function showQuestion(moveFocus = false) {
      session.hidden = false;
      resultBox.hidden = true;
      reset.textContent = "Начать заново";
      position.textContent = `Вопрос ${index + 1} из ${questions.length}`;
      questionText.textContent = questions[index].text;
      delete card.dataset.state;
      feedback.hidden = true;
      feedback.replaceChildren();
      next.disabled = true;
      next.textContent = index === questions.length - 1 ? "Показать результат" : "Следующий вопрос";
      options.replaceChildren(...questions[index].options.map((text, optionIndex) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "quiz-option";
        button.dataset.answer = "";
        button.value = String(optionIndex + 1);
        const number = document.createElement("span");
        number.className = "quiz-option-number";
        number.setAttribute("aria-hidden", "true");
        number.textContent = String(optionIndex + 1);
        const label = document.createElement("span");
        label.textContent = text;
        button.append(number, label);
        return button;
      }));
      updateProgress();
      if (answers[index] !== null) showFeedback();
      if (moveFocus) position.focus();
    }

    function makeResult() {
      const mistakes = questions.flatMap((question, i) => answers[i] === question.answer ? [] : [{
        text: question.text,
        answerText: question.options[question.answer - 1],
        explanation: question.explanation,
        source: question.source
      }]);
      const score = questions.length - mistakes.length;
      return {
        version, score, total: questions.length, passed: score / questions.length >= 0.8,
        answers: [...answers], mistakes, updatedAt: new Date().toISOString()
      };
    }

    function showResult(result, moveFocus = false) {
      session.hidden = true;
      resultBox.hidden = false;
      reset.textContent = "Пройти ещё раз";
      resultBox.innerHTML = `
        <h3>${result.passed ? "Тест пройден" : "Тест требует повторения"}</h3>
        <p>Результат: <strong>${result.score} из ${result.total}</strong> (${Math.round(result.score / result.total * 100)}%). Ошибок: ${result.mistakes.length}.</p>
        ${result.mistakes.length ? `<details><summary>Разбор ошибок (${result.mistakes.length})</summary><ol>${result.mistakes.map((mistake) => `<li>
          <strong>${escapeHtml(mistake.text)}</strong>
          <p>Правильный ответ: ${escapeHtml(mistake.answerText)}</p>
          ${mistake.explanation ? `<p>${escapeHtml(mistake.explanation)}</p>` : ""}
          ${mistake.source ? `<p class="source">${escapeHtml(mistake.source)}</p>` : ""}
        </li>`).join("")}</ol></details>` : "<p>Можно переходить к следующему разделу.</p>"}
      `;
      if (moveFocus) resultBox.focus();
    }

    options.addEventListener("click", (event) => {
      const button = event.target.closest("[data-answer]");
      if (!button || button.disabled || answers[index] !== null) return;
      const answer = Number(button.value);
      if (!validAnswer(answer, index)) return;
      answers[index] = answer;
      showFeedback();
      saveSession();
      feedback.focus();
    });

    next.addEventListener("click", () => {
      if (answers[index] === null || session.hidden) return;
      if (index < questions.length - 1) {
        index++;
        saveSession();
        showQuestion(true);
      } else {
        const result = makeResult();
        writeStore(quizResultsKey, slug, result);
        writeStore(sessionsKey, slug, null);
        window.dispatchEvent(new CustomEvent("potee-progress-updated"));
        showResult(result, true);
      }
    });

    reset.addEventListener("click", () => {
      index = 0;
      answers = questions.map(() => null);
      saveSession();
      showQuestion(true);
    });

    const savedSession = readStore(sessionsKey)[slug];
    const savedResult = readStore(quizResultsKey)[slug];
    const canResume = savedSession?.version === version && Number.isInteger(savedSession.index)
      && savedSession.index >= 0 && savedSession.index < questions.length
      && Array.isArray(savedSession.answers) && savedSession.answers.length === questions.length
      && savedSession.answers.every((answer, i) => i < savedSession.index ? validAnswer(answer, i)
        : i === savedSession.index ? answer === null || validAnswer(answer, i) : answer === null);
    if (canResume) {
      index = savedSession.index;
      answers = savedSession.answers;
      showQuestion();
    } else if (savedResult && (!savedResult.version || savedResult.version === version)
      && Array.isArray(savedResult.answers) && savedResult.answers.length === questions.length
      && savedResult.answers.every(validAnswer)) {
      answers = savedResult.answers;
      showResult(makeResult());
    } else {
      showQuestion();
    }
  }

  document.querySelectorAll("[data-quiz]").forEach(setupQuiz);
</script>
