---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PresentationViewer from "../../components/PresentationViewer.astro";
import ProgressBadge from "../../components/ProgressBadge.astro";
import Quiz from "../../components/Quiz.astro";
import { withBase } from "../../lib/url";
import {
  getCourseModules,
  getModuleBySlug,
  getPresentationBySlug,
  getQuizBySlug,
  getSimpleBySlug,
  getStoryBySlug,
  getSlugFromEntryId
} from "../../lib/course";

export async function getStaticPaths() {
  const modules = await getCourseModules();
  return modules.map((module) => ({
    params: { slug: getSlugFromEntryId(module.id) }
  }));
}

const { slug } = Astro.params;
const modules = await getCourseModules();
const moduleEntry = await getModuleBySlug(slug);

if (!moduleEntry) {
  return Astro.redirect(withBase("/"));
}

const presentationEntry = await getPresentationBySlug(slug);
const quizEntry = await getQuizBySlug(slug);
const simpleEntry = moduleEntry.data.kind === "rule" && slug ? await getSimpleBySlug(slug) : null;
const storyEntry = slug ? await getStoryBySlug(slug) : null;
const moduleIndex = modules.findIndex((module) => getSlugFromEntryId(module.id) === slug);
const previousModule = moduleIndex > 0 ? modules[moduleIndex - 1] : null;
const nextModule = moduleIndex >= 0 && moduleIndex < modules.length - 1 ? modules[moduleIndex + 1] : null;
const { Content: ModuleContent } = await render(moduleEntry);
const renderedPresentation = presentationEntry ? await render(presentationEntry) : null;
const PresentationContent = renderedPresentation?.Content;
const renderedSimple = simpleEntry ? await render(simpleEntry) : null;
const SimpleContent = renderedSimple?.Content;
const renderedStory = storyEntry ? await render(storyEntry) : null;
const StoryContent = renderedStory?.Content;
---

<BaseLayout title={`${moduleEntry.data.title} | Курс ПОТЭЭ`}>
  <article class="module-page" data-module-page data-slug={slug}>
    <nav class="module-nav" aria-label="Переход между разделами">
      {previousModule && (
        <a class="module-nav__link module-nav__link--previous" href={withBase(`/modules/${getSlugFromEntryId(previousModule.id)}/`)}>
          <span class="module-nav__label">Предыдущий раздел</span>
          <span class="module-nav__title">← {previousModule.data.title}</span>
        </a>
      )}
      {nextModule && (
        <a class="module-nav__link module-nav__link--next" href={withBase(`/modules/${getSlugFromEntryId(nextModule.id)}/`)}>
          <span class="module-nav__label">Следующий раздел</span>
          <span class="module-nav__title">{nextModule.data.title} →</span>
        </a>
      )}
    </nav>

    <header class="module-header">
      <div>
        <p class="eyebrow">{moduleEntry.data.kind === "appendix" ? "Приложение" : "Раздел"} {moduleEntry.data.number}</p>
        <h1>{moduleEntry.data.title}</h1>
      </div>
      <ProgressBadge slug={slug} />
    </header>

    <div class="tabs tabs--primary" role="tablist" aria-label="Раздел курса">
      <button id="tab-materials" type="button" role="tab" tabindex="0" aria-selected="true" aria-controls="panel-materials" data-main-tab="materials">
        Материалы
      </button>
      <button id="tab-testing" type="button" role="tab" tabindex="-1" aria-selected="false" aria-controls="panel-testing" data-main-tab="testing">
        Тестирование
      </button>
    </div>

    <section class="tab-panel" id="panel-materials" role="tabpanel" aria-labelledby="tab-materials" tabindex="0" data-main-panel="materials">
      <div class="tabs tabs--nested" role="tablist" aria-label="Материалы раздела">
        <button id="tab-materials-rules" type="button" role="tab" tabindex="0" aria-selected="true" aria-controls="panel-materials-rules" data-material-tab="materials-rules">
          Правила
        </button>
        <button id="tab-materials-simple" type="button" role="tab" tabindex="-1" aria-selected="false" aria-controls="panel-materials-simple" data-material-tab="materials-simple">
          Простыми словами
        </button>
        <button id="tab-materials-presentation" type="button" role="tab" tabindex="-1" aria-selected="false" aria-controls="panel-materials-presentation" data-material-tab="materials-presentation">
          Презентация
        </button>
        <button id="tab-materials-podcast" type="button" role="tab" tabindex="-1" aria-selected="false" aria-controls="panel-materials-podcast" data-material-tab="materials-podcast">
          Подкаст
        </button>
        <button id="tab-materials-story" type="button" role="tab" tabindex="-1" aria-selected="false" aria-controls="panel-materials-story" data-material-tab="materials-story">
          Рассказ
        </button>
      </div>

      <section class="nested-tab-panel" id="panel-materials-rules" role="tabpanel" aria-labelledby="tab-materials-rules" tabindex="0" data-material-panel="materials-rules">
        <div class="panel-actions">
          <button class="button button--secondary" type="button" data-mark-material>
            Отметить материал изученным
          </button>
        </div>
        <div class="prose prose--rules">
          <ModuleContent />
        </div>
      </section>

      <section class="nested-tab-panel" id="panel-materials-simple" role="tabpanel" aria-labelledby="tab-materials-simple" tabindex="0" data-material-panel="materials-simple" hidden>
        {SimpleContent ? (
          <div class="prose prose--simple">
            <SimpleContent />
          </div>
        ) : (
          <div class="empty-state">
            <p>Материал простыми словами для этого раздела еще не добавлен.</p>
          </div>
        )}
      </section>

      <section class="nested-tab-panel" id="panel-materials-presentation" role="tabpanel" aria-labelledby="tab-materials-presentation" tabindex="0" data-material-panel="materials-presentation" hidden>
        {PresentationContent ? (
          <PresentationViewer slug={slug} draft={presentationEntry.data.draft}>
            <PresentationContent />
          </PresentationViewer>
        ) : (
          <p class="notice">Презентация еще не добавлена.</p>
        )}
      </section>

      <section class="nested-tab-panel" id="panel-materials-podcast" role="tabpanel" aria-labelledby="tab-materials-podcast" tabindex="0" data-material-panel="materials-podcast" hidden>
        <div class="empty-state">
          <p>Подкаст для этого раздела еще не добавлен.</p>
        </div>
      </section>

      <section class="nested-tab-panel" id="panel-materials-story" role="tabpanel" aria-labelledby="tab-materials-story" tabindex="0" data-material-panel="materials-story" hidden>
        {StoryContent ? (
          <div class="prose prose--story">
            <StoryContent />
          </div>
        ) : (
          <div class="empty-state">
            <p>Рассказ для этого раздела еще не добавлен.</p>
          </div>
        )}
      </section>
    </section>

    <section class="tab-panel" id="panel-testing" role="tabpanel" aria-labelledby="tab-testing" tabindex="0" data-main-panel="testing" hidden>
      {quizEntry ? <Quiz slug={slug} quiz={quizEntry.data} /> : <p class="notice">Тест еще не добавлен.</p>}
    </section>

  </article>
</BaseLayout>

<script>
  function readStudyProgress() {
    try {
      return JSON.parse(localStorage.getItem("potee:study-progress:v1") || "{}");
    } catch {
      return {};
    }
  }

  function writeStudyProgress(slug, patch) {
    const progress = readStudyProgress();
    progress[slug] = { ...(progress[slug] || {}), ...patch, updatedAt: new Date().toISOString() };
    localStorage.setItem("potee:study-progress:v1", JSON.stringify(progress));
    window.dispatchEvent(new CustomEvent("potee-progress-updated"));
  }

  document.querySelectorAll("[data-module-page]").forEach((page) => {
    const slug = page.dataset.slug;
    const mainTabs = Array.from(page.querySelectorAll("[data-main-tab]"));
    const mainPanels = Array.from(page.querySelectorAll("[data-main-panel]"));
    const materialTabs = Array.from(page.querySelectorAll("[data-material-tab]"));
    const materialPanels = Array.from(page.querySelectorAll("[data-material-panel]"));
    const materialTabNames = [
      "materials-rules",
      "materials-simple",
      "materials-presentation",
      "materials-podcast",
      "materials-story"
    ];
    const legacyHashes = {
      material: "materials-rules",
      presentation: "materials-presentation",
      quiz: "testing"
    };

    function activateMain(tabName) {
      mainTabs.forEach((tab) => {
        const selected = tab.dataset.mainTab === tabName;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      mainPanels.forEach((panel) => {
        panel.hidden = panel.dataset.mainPanel !== tabName;
      });
    }

    function activateMaterial(tabName) {
      materialTabs.forEach((tab) => {
        const selected = tab.dataset.materialTab === tabName;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      materialPanels.forEach((panel) => {
        panel.hidden = panel.dataset.materialPanel !== tabName;
      });
    }

    function activate(sectionName, updateHash = true) {
      const normalizedSection = legacyHashes[sectionName] || sectionName;

      if (normalizedSection === "testing") {
        activateMain("testing");
      } else if (materialTabNames.includes(normalizedSection)) {
        activateMain("materials");
        activateMaterial(normalizedSection);
      } else {
        return;
      }

      if (updateHash && location.hash !== `#${normalizedSection}`) {
        history.replaceState(null, "", `#${normalizedSection}`);
      }
    }

    mainTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        if (tab.dataset.mainTab === "testing") {
          activate("testing");
          return;
        }

        const activeMaterialTab = materialTabs.find((item) => item.getAttribute("aria-selected") === "true");
        activate(activeMaterialTab?.dataset.materialTab || "materials-rules");
      });
    });

    materialTabs.forEach((tab) => {
      tab.addEventListener("click", () => activate(tab.dataset.materialTab));
    });

    // Each tablist is one Tab stop; arrows/Home/End select and focus its tabs.
    [mainTabs, materialTabs].forEach((tabs) => {
      tabs.forEach((tab, index) => {
        tab.addEventListener("keydown", (event) => {
          if (event.ctrlKey || event.metaKey || event.altKey) return;
          const next = {
            ArrowLeft: (index - 1 + tabs.length) % tabs.length,
            ArrowRight: (index + 1) % tabs.length,
            Home: 0,
            End: tabs.length - 1
          }[event.key];
          if (next === undefined) return;
          event.preventDefault();
          tabs[next].click();
          tabs[next].focus();
        });
      });
    });

    const initial = location.hash.replace("#", "");
    if (initial) activate(initial, Boolean(legacyHashes[initial]));

    page.querySelector("[data-mark-material]")?.addEventListener("click", (event) => {
      writeStudyProgress(slug, { materialRead: true });
      event.currentTarget.textContent = "Материал отмечен";
    });
  });
</script>
